# BallDontLie API key (free tier: 5 req/min)
# Get yours at https://www.balldontlie.io
BDL_API_KEY=your_bdl_api_key_here

# The Odds API key
# Get yours at https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# OpenAI API key for daily AI PICKS generation
OPENAI_API_KEY=your_openai_api_key_here

# Required for admin job trigger routes
ADMIN_SECRET=your_secret_here

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: direct Postgres URL for running SQL migrations
# SUPABASE_DB_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# Optional: server port (default 3001)
# PORT=3001

# Optional: Discord/Slack-compatible webhook for scheduler failure alerts
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token

# Ops (local): npm run verify:ops — checks slate freshness in Supabase (same fields as GET /health → slate).
